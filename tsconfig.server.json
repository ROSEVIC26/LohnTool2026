{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "node",
    "strict": true,
    "noImplicitAny": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "outDir": "./server-dist",
    "rootDir": ".",
    "sourceMap": true,
    "lib": ["ES2020"]
  },
  "include": [
    "server/**/*.ts",
    "src/LST2026.ts",
    "src/SV2026.ts"
  ]
}